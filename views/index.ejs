<%layout("layouts/boilerplate")%>
<main class="home-listings">
    <section class="filter-toolbar" aria-label="Browse listing categories">
        <div class="filter-scroll-wrap">
            <div id="filters">
                <% categories.forEach((category) => { %>
                    <a class="filter <%= selectedCategory === category.value ? 'active' : '' %>" href="/listings?category=<%= category.value %>">
                        <i class="fa-solid <%= category.icon %>" aria-hidden="true"></i>
                        <span><%= category.label %></span>
                    </a>
                <% }); %>
            </div>
        </div>
        <div class="tax-toggle form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </section>

    <section class="listing-grid" aria-label="Available stays">
    <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <article class="listing-card">
                <img src="<%= listing.image.url %>" class="listing-image" alt="<%= listing.title %>">
                <div class="listing-details">
                    <h2 class="listing-title"><%= listing.title %></h2>
                    <p class="listing-location"><%= listing.location %>, <%= listing.country %></p>
                    <p class="listing-price" data-price="<%= listing.price %>">₹<span><%= listing.price.toLocaleString('en-IN') %></span><span class="price-suffix"> / night</span></p>
                    <span class="tax-info">+18% GST included</span>
                </div>
            </article>
        </a>
    <% } %>
    </section>
</main>
<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch?.addEventListener("change", () => {
        document.querySelectorAll(".tax-info").forEach((info) => {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        });
        document.querySelectorAll(".listing-price").forEach((price) => {
            const basePrice = Number(price.dataset.price);
            const totalPrice = taxSwitch.checked ? basePrice * 1.18 : basePrice;
            price.querySelector("span").textContent = totalPrice.toLocaleString("en-IN", {
                maximumFractionDigits: 0,
            });
        });
    });
</script>

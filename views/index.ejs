<%layout("layouts/boilerplate")%>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
    <h3 class="col-12">All Listings</h3>
    <% for (let listing of allListings) { %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="card-link listing-link text-decoration-none text-dark">
                <div class="card h-100 listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" height="220">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text"><b><%= listing.title %></b></p>
                        <p>₹<%= listing.price.toLocaleString('en-IN') %>/night</p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>


<%layout("layouts/boilerplate")%>
<div class="row">
    <div class="col-8 offset-2">
        <h3>Listing Details</h3>
        <div class="card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
        <i>Owned by <%= listing.owner?.username || "Unknown User" %></i>
        <p class="card-text"><b><%= listing.title %></b><br><%= listing.description %><br>Price: &#8377;<%= listing.price.toLocaleString("en-IN") %><br> <%= listing.location %><br>Country: <%= listing.country %></p>
        </div>
        <div class="d-flex gap-2 mt-3">
            <% if (listing.owner && currUser && listing.owner._id.equals(currUser._id)) { %>
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-outline-danger">Delete</button>
                </form>     
            <% } %>
        </div>

        </div>

        <section class="listing-map-section" aria-labelledby="listing-location-heading">
            <h4 id="listing-location-heading">Where you'll be</h4>
            <div id="listing-map" class="listing-map" data-location="<%= listing.location %>" data-country="<%= listing.country %>">
                <p class="map-status">Loading map...</p>
            </div>
        </section>

    </div>
    <% if (currUser) { %>
    <div class="col-8 offset-3">
        <h4>Leave a Review</h4>
        <form class="mb-3 needs-validation" action="/listings/<%= listing._id %>/reviews" method="POST" novalidate >
            <div class="mb-3 mt-3">
                <fieldset class="starability-slot">
                    <legend class="form-label">Rating</legend>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked />
                    
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>    
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" /> 
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                        <span class="starability-focus-ring"></span>
                    </fieldset>
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" class="form-control" cols="30" rows="5" required></textarea>
            <div class="invalid-feedback">Please enter your comment.</div>
            </div>
            <button type="submit" class="btn btn-outline-dark">Submit</button>
        </form>
    </div>
    <% } %>
    <div class="col-8 offset-2 mt-4">
        <h4>All Reviews</h4>
        <div class="row g-3">
            <% for(review of listing.reviews) { %>
            <div class="col-md-6">
                <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title"><%= review.author.username  %></h5>
                    <% const safeRating = Math.max(1, Math.min(5, Number(review.rating) || 1)); %>
                    <p class="starability-result" data-rating="<%= safeRating %>">Rated: <%= safeRating %> stars</p>
                    <p class="card-text"><%= review.comment %></p>
                    <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                        <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    <% } %>
                </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>
